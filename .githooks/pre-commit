#!/usr/bin/env bash
# -------------------------------------------------------
#  pre-commit — keep the deployed tree optimized.
#  When JS, journal JSON or pages are staged, run
#  tools/build-assets.sh for the matching parts and stage
#  the minified outputs and rewritten pages.
#
#  Enable once per clone:  git config core.hooksPath .githooks
#  Skip for one commit:    git commit --no-verify
# -------------------------------------------------------
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

flags=()
if printf '%s\n' "$staged" | grep -E '^assets/(js|data)/[^/]+\.js$' | grep -qv '\.min\.js$'; then
  flags+=(--js --html)
fi
if printf '%s\n' "$staged" | grep -E '^assets/journal/.+\.json$' | grep -qv '/journal\.min\.json$'; then
  flags+=(--journal)
fi
if printf '%s\n' "$staged" | grep -qE '^[^/]+\.html$'; then
  flags+=(--html)
fi
[ ${#flags[@]} -gt 0 ] || exit 0

outputs() {
  ls assets/js/*.min.js assets/data/*.min.js assets/journal/journal.min.json ./*.html 2>/dev/null | sed 's#^\./##'
}
dirty_before=$(git diff --name-only)
tools/build-assets.sh "${flags[@]}"

# Stage every generated file that does not match its source: the ones this run
# rebuilt, ones an earlier manual build left modified, and ones git has never
# seen. A generated file left behind means the deployed page loads stale code.
to_add=""
for f in $(outputs); do
  case "$f" in
    *.html)
      # Pages are only swept in when their diff touches a script tag, so an
      # unrelated edit in flight is never pulled into someone else's commit.
      if git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
        git diff --quiet -- "$f" && continue
        git diff -U0 -- "$f" | grep -qE '^[+-][[:space:]]*<script[[:space:]]+src=' || continue
      fi
      ;;
    *)
      if git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
        git diff --quiet -- "$f" && continue
      fi
      ;;
  esac
  to_add="$to_add$f
"
done
to_add=$(printf '%s' "$to_add" | sed '/^$/d' | sort -u)

if [ -n "$to_add" ]; then
  for f in $to_add; do
    if printf '%s\n' "$dirty_before" | grep -qx "$f"; then
      echo "pre-commit: note - $f also had unstaged edits; the whole file is now staged" >&2
    fi
  done
  git add -- $to_add
  echo "pre-commit: staged $(printf '%s\n' "$to_add" | wc -l | tr -d ' ') generated file(s)"
fi

# Many working copies in this tree carry a stray +x bit that would land in the
# commit as a mode change. Clear it for every staged file that is not actually
# a script; a shebang on the first line is what marks one as executable.
normalized=0
for f in $(git diff --cached --summary | awk '/mode change 100644 => 100755/{print $NF}'); do
  [ -f "$f" ] || continue
  [ "$(head -c 2 "$f" 2>/dev/null)" = '#!' ] && continue
  git update-index --chmod=-x "$f" 2>/dev/null && normalized=$((normalized + 1)) || true
done
[ "$normalized" -gt 0 ] && echo "pre-commit: cleared a stray +x bit on $normalized staged file(s)"
exit 0
